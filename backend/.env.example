# Copy to .env next to app.py and fill in locally. Never commit .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_LIVE_MODE=0
# This backend's own public URL (used for the Stripe HTTPS-in-live-mode check).
PUBLIC_URL=http://127.0.0.1:5005
# The static frontend's URL, e.g. https://yourname.github.io/your-repo.
# Stripe redirects the browser back here after checkout/portal.
FRONTEND_URL=http://127.0.0.1:5500
# Comma-separated origins allowed to call this API with cookies. Defaults to FRONTEND_URL.
FRONTEND_ORIGIN=http://127.0.0.1:5500
# Cross-origin cookies require SameSite=None + Secure (HTTPS). Only relax these
# for local http testing on the same machine.
COOKIE_SAMESITE=None
COOKIE_SECURE=1
PORT=5005

# Separate sandbox data; relative paths are resolved beside app.py.
AI_DATA_DIR=instance-stripe-test
LLAMA_URL=http://127.0.0.1:8080
LLAMA_API_KEY=local-llama
LLAMA_MODEL=local-model
SD_URL=http://127.0.0.1:8081
CONTEXT_TOKENS=32768
MAX_RESPONSE_TOKENS=2048
PAID_CHAT_LIMIT=0
PAID_IMAGE_LIMIT=0
# Optional: omit to retain the auto-generated instance/session.key.
# FLASK_SECRET_KEY=YOUR_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
